<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.danuvius.platform.mapper.AlarmRuleMapper">
    <resultMap id="BaseResultMap" type="com.danuvius.platform.model.entity.AlarmRule">
        <id property="id" column="id" jdbcType="VARCHAR"/>
        <result property="ruleId" column="rule_id" jdbcType="VARCHAR"/>
        <result property="ruleName" column="rule_name" jdbcType="VARCHAR"/>
        <result property="metricKey" column="metric_key" jdbcType="VARCHAR"/>
        <result property="metricName" column="metric_name" jdbcType="VARCHAR"/>
        <result property="compareType" column="compare_type" jdbcType="VARCHAR"/>
        <result property="threshold" column="threshold" jdbcType="VARCHAR"/>
        <result property="unit" column="unit" jdbcType="VARCHAR"/>
        <result property="collectInterval" column="collect_interval" jdbcType="VARCHAR"/>
        <result property="duration" column="duration" jdbcType="VARCHAR"/>
        <result property="alarmLevel" column="alarm_level" jdbcType="VARCHAR"/>
        <result property="silenceDuration" column="silence_duration" jdbcType="VARCHAR"/>
        <result property="scopeType" column="scope_type" jdbcType="VARCHAR"/>
        <result property="scopeInstanceId" column="scope_instance_id" jdbcType="VARCHAR"/>
        <result property="enableStatus" column="enable_status" jdbcType="VARCHAR"/>
        <result property="delFlag" column="del_flag" jdbcType="VARCHAR"/>
        <result property="createdBy" column="created_by" jdbcType="VARCHAR"/>
        <result property="createdTime" column="created_time" jdbcType="TIMESTAMP"/>
        <result property="updatedTime" column="updated_time" jdbcType="TIMESTAMP"/>
    </resultMap>



    <resultMap id="AlarmRuleItemResultMap" type="com.danuvius.platform.model.dto.alarm.rule.RuleItemDTO">
        <id property="ruleId" column="rule_id" jdbcType="VARCHAR"/>
        <result property="ruleName" column="rule_name" jdbcType="VARCHAR"/>
        <result property="metricKey" column="metric_key" jdbcType="VARCHAR"/>
        <result property="compareType" column="compare_type" jdbcType="VARCHAR"/>
        <result property="threshold" column="threshold" jdbcType="VARCHAR"/>
        <result property="unit" column="unit" jdbcType="VARCHAR"/>
        <result property="collectInterval" column="collect_interval" jdbcType="VARCHAR"/>
        <result property="duration" column="duration" jdbcType="VARCHAR"/>
        <result property="alarmLevel" column="alarm_level" jdbcType="VARCHAR"/>
        <result property="silenceDuration" column="silence_duration" jdbcType="VARCHAR"/>
        <result property="scopeType" column="scope_type" jdbcType="VARCHAR"/>
        <result property="scopeInstanceId" column="scope_instance_id" jdbcType="VARCHAR"/>
        <result property="enableStatus" column="enable_status" jdbcType="VARCHAR"/>
        <result property="createdTime" column="created_time" jdbcType="TIMESTAMP"/>
        <result property="updatedTime" column="updated_time" jdbcType="TIMESTAMP"/>
    </resultMap>



    <select id="selectRuleOverview" resultType="com.danuvius.platform.model.dto.alarm.rule.RuleOverviewDTO">
        SELECT
            (SELECT COUNT(*) FROM alarm_rule WHERE del_flag = '0' AND enable_status = '1') as "enableRuleCount",
            (SELECT COUNT(*) FROM alarm_record WHERE recover_status = '0') as "unrecoveredAlarmCount",
            (SELECT COUNT(*) FROM alarm_record WHERE trigger_time >= CURRENT_DATE) as "todayAlarmTotal",
            (SELECT COUNT(*) FROM alarm_record WHERE trigger_time >= CURRENT_DATE AND alarm_level = '1') as "todayInfoCount",
            (SELECT COUNT(*) FROM alarm_record WHERE trigger_time >= CURRENT_DATE AND alarm_level = '2') as "todayAlarmCount",
            (SELECT COUNT(*) FROM alarm_record WHERE trigger_time >= CURRENT_DATE AND alarm_level = '3') as "todaySeverityCount"
    </select>






</mapper>
