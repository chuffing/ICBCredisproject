<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.danuvius.platform.mapper.NodeStatusMapper">

    <!-- 节点状态日志结果映射 -->
    <resultMap id="BaseResultMap" type="com.danuvius.platform.model.entity.NodeStatus">
        <id column="id" property="id"/>
        <result column="instance_id" property="instanceId"/>
        <result column="run_id" property="runId"/>
        <result column="tm" property="tm"/>
        <result column="collect_status" property="collectStatus"/>
        <result column="error_msg" property="errorMsg"/>
        <result column="role" property="role"/>
        <result column="ping_latency" property="pingLatency"/>
        <result column="created_time" property="createdTime"/>
        <result column="updated_time" property="updatedTime"/>
    </resultMap>

    <!-- 通用查询列 -->
    <sql id="Base_Column_List">
        id, instance_id, run_id, tm, collect_status, error_msg,
        role, ping_latency, created_time, updated_time
    </sql>


</mapper>