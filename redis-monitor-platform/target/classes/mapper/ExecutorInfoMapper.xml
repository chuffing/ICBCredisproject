<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.danuvius.platform.mapper.ExecutorInfoMapper">

    <resultMap id="BaseResultMap" type="com.danuvius.platform.model.entity.ExecutorInfo">
        <id     column="id"                  property="id"/>
        <result column="instance_id"         property="instanceId"/>
        <result column="host_ip"             property="hostIp"/>
        <result column="executor_port"       property="executorPort"/>
        <result column="executor_token"      property="executorToken"/>
        <result column="executor_status"     property="executorStatus"/>
        <result column="management_status"   property="managementStatus"/>
        <result column="last_heartbeat_time" property="lastHeartbeatTime"/>
        <result column="last_report_time"    property="lastReportTime"/>
        <result column="created_time"        property="createdTime"/>
        <result column="updated_time"        property="updatedTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,instance_id, host_ip, executor_port, executor_token,
        executor_status, management_status, last_heartbeat_time, last_report_time,
        created_time, updated_time
    </sql>


</mapper>